  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Dashboard",
      "items": [
        "React Frontend (Vite, Port 5175) manages app state, user preferences, and real-time feeds",
        "Lightweight Charts components plot rolling GARCH forecasts, Kalman betas, Nadaraya-Watson estimations, and probability series",
        "FastAPI Server (Uvicorn, Port 8888) handles API requests and pushes websocket frames every 5s"
      ]
    },
    {
      "dot": "emerald",
      "title": "Collector Pipeline",
      "items": [
        "Collector thread pools XP, Tickmill, and Axi MT5 terminals for live M5 rates",
        "Calculates delta volume and commits OHLCV arrays to SQLite market_bars table",
        "Triggers API notify endpoint to reload engine configuration and broadcast changes"
      ]
    },
    {
      "dot": "violet",
      "title": "Database Schema & Math Engine",
      "items": [
        "market_bars: stores raw price history and tick delta volumes",
        "kalman_state & asset_models: stores rolling means, covariance matrices, and Johansen parameters",
        "IRAI Engine: solves cointegration equations and filters pricing divergences dynamically"
      ]
    }
  ]
