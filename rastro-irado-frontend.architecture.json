    {
      "dot": "cyan",
      "title": "Ingress & State",
      "items": [
        "WebSocket client registers with Uvicorn backend, receiving real-time JSON frames on update events",
        "React hooks manage target active state, overview grids, accuracy metrics, and visual thresholds"
      ]
    },
    {
      "dot": "emerald",
      "title": "Signal Processing Panel",
      "items": [
        "SignalGauge calculates conviction indices using Shrinkage adjustments against calibrated accuracy parameters",
        "Matures signal stability ratings (estável, formando, oscilando) by checking historical standard deviation and mean crossings",
        "Triggers alert cards if asset prices diverge from expected cointegrated Kalman returns"
      ]
    },
    {
      "dot": "violet",
      "title": "Lightweight Charts View",
      "items": [
        "Renders responsive timeseries plots using high-performance HTML5 canvas graphics",
        "TVProbabilityChart & TVNweChart display probability envelopes and kernel regressions",
        "TVKalmanWeightsChart & TVGarchVolChart plot dynamic co-efficients and forecasted GARCH volatility curves"
